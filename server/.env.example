# Copy this file to .env for local development, then replace the placeholders.
# Keep real credentials in .env or your hosting provider's environment settings.

# Server
# Use production on the hosted backend. The host may provide PORT automatically.
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string, including an explicit database name.
# URL-encode special characters in the database password.
MONGO_URI=mongodb+srv://YOUR_DB_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/audiophile?retryWrites=true&w=majority

# Replace with a long, randomly generated secret. Never use this placeholder.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Allowed frontend origins, separated by commas, with no trailing slash.
# On the hosted backend, set this to your deployed frontend origin.
CLIENT_URL=http://localhost:5173

# Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
